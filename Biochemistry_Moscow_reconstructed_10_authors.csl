<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       class="in-text"
       version="1.0"
       default-locale="en-US"
       demote-non-dropping-particle="sort-only">
  <info>
    <title>Biochemistry (Moscow) (2019) — reconstructed, 10 authors</title>
    <title-short>Biochemistry (Moscow) 2019</title-short>
    <id>http://www.zotero.org/styles/biochemistry-moscow-2019-reconstructed-10-authors</id>
    <link href="http://www.zotero.org/styles/biochemistry-moscow-2019-reconstructed-10-authors" rel="self"/>
    <category citation-format="numeric"/>
    <category field="biology"/>
    <category field="chemistry"/>
    <issn>0006-2979</issn>
    <eissn>1608-3040</eissn>
    <summary>Manually reconstructed from the EndNote output style “Biochemistry (Moscow) (2019).ens” and checked against the supplied manuscript sample.</summary>
    <updated>2026-08-04T19:22:00+00:00</updated>
  </info>

  <!-- ENS author output: surname first, initials with periods, ", and " before final author. -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            and="text"
            delimiter=", "
            delimiter-precedes-last="always"/>
      <et-al font-style="normal"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            and="text"
            delimiter=", "
            delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued" prefix=" (" suffix=") ">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi: "/>
      </if>
    </choose>
  </macro>

  <!-- EndNote reference type 0: Journal Article
       Author. (Year) Title, Journal, Volume, Pages, doi: DOI. -->
  <macro name="journal-article">
    <group>
      <text variable="title"/>
      <text variable="container-title" form="short" font-style="italic" prefix=", "/>
      <text variable="volume" font-weight="bold" prefix=", "/>
      <text variable="page" prefix=", "/>
      <text variable="issue" prefix=", "/>
      <text macro="doi" prefix=", "/>
    </group>
  </macro>

  <!-- EndNote reference type 1: Book
       Author. (Year) Title, edition ed., Publisher, Place. -->
  <macro name="book">
    <group>
      <text variable="title" font-style="italic"/>
      <group prefix=", " delimiter=" ">
        <number variable="edition" form="ordinal"/>
        <text term="edition" form="short"/>
      </group>
      <text variable="collection-title" font-style="italic" prefix=", "/>
      <text variable="publisher" prefix=", "/>
      <text variable="publisher-place" prefix=", "/>
    </group>
  </macro>

  <!-- EndNote reference type 7: Book Section
       Author. (Year) Chapter. in Book (Editor ed./eds.), edition, Publisher, Place, pp Pages. -->
  <macro name="chapter">
    <group>
      <text variable="title"/>
      <text term="in" text-case="lowercase" prefix=". " suffix=" "/>
      <text variable="container-title" font-style="italic"/>
      <names variable="editor" prefix=" (" suffix=")">
        <name name-as-sort-order="all"
              sort-separator=", "
              initialize-with=". "
              and="text"
              delimiter=", "
              delimiter-precedes-last="always"/>
        <label form="short" prefix=" " suffix="." strip-periods="true"/>
      </names>
      <group prefix=", " delimiter=" ">
        <number variable="edition" form="ordinal"/>
        <text term="edition" form="short"/>
      </group>
      <text variable="publisher" prefix=", "/>
      <text variable="publisher-place" prefix=", "/>
      <group prefix=", ">
        <label variable="page" form="short" suffix=" " strip-periods="true"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>

  <!-- EndNote reference type 9: Edited Book -->
  <macro name="edited-book">
    <group>
      <names variable="editor">
        <name name-as-sort-order="all"
              sort-separator=", "
              initialize-with=". "
              and="text"
              delimiter=", "
              delimiter-precedes-last="always"/>
        <label form="short" prefix=" (" suffix=")."/>
      </names>
      <date variable="issued" prefix=" (" suffix=") ">
        <date-part name="year"/>
      </date>
      <text variable="title" font-style="italic"/>
      <text variable="volume" font-weight="bold" prefix=", Vol. "/>
      <text variable="publisher" prefix=", "/>
      <text variable="publisher-place" prefix=", "/>
    </group>
  </macro>

  <!-- EndNote reference type 31: Electronic Article -->
  <macro name="electronic">
    <group>
      <text variable="title" font-style="italic"/>
      <text variable="container-title" font-style="italic" prefix=". "/>
      <group prefix=", " delimiter=" ">
        <number variable="edition" form="ordinal"/>
        <text term="edition" form="short"/>
      </group>
      <text variable="publisher" prefix=", "/>
      <text variable="publisher-place" prefix=", "/>
      <choose>
        <if variable="DOI">
          <text macro="doi" prefix=", "/>
        </if>
        <else-if variable="URL">
          <text variable="URL" prefix=", "/>
        </else-if>
      </choose>
    </group>
  </macro>

  <!-- ENS citation template: [Bibliography Number].
       Consecutive numbers collapse to ranges with an en dash. -->
  <citation collapse="citation-number" after-collapse-delimiter=", ">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <!-- The supplied manuscript demonstrates first 5 authors + et al. from 6 authors onward. -->
  <bibliography et-al-min="11"
                et-al-use-first="5"
                et-al-use-last="false"
                second-field-align="flush"
                entry-spacing="0"
                line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="edited-book" match="any">
          <text macro="edited-book"/>
        </if>
        <else>
          <text macro="author" suffix="."/>
          <text macro="year"/>
          <choose>
            <if type="article-journal article-magazine article-newspaper" match="any">
              <text macro="journal-article"/>
            </if>
            <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
              <text macro="chapter"/>
            </else-if>
            <else-if type="book report thesis" match="any">
              <text macro="book"/>
            </else-if>
            <else-if type="webpage post post-weblog article" match="any">
              <text macro="electronic"/>
            </else-if>
            <else>
              <text variable="title"/>
              <text variable="container-title" font-style="italic" prefix=", "/>
              <text variable="volume" font-weight="bold" prefix=", "/>
              <text variable="page" prefix=", "/>
              <text macro="doi" prefix=", "/>
            </else>
          </choose>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
