<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       class="in-text"
       version="1.0"
       default-locale="en-US"
       demote-non-dropping-particle="sort-only">
  <info>
    <title>Biochemistry Moscow Current</title>
    <title-short>Biochemistry Moscow</title-short>
    <id>http://www.zotero.org/styles/biochemistry-moscow-current-custom</id>
    <link href="http://www.zotero.org/styles/biochemistry-moscow-current-custom" rel="self"/>
    <link href="https://biochemistrymoscow.com/ru/authors/" rel="documentation"/>
    <category citation-format="numeric"/>
    <category field="biology"/>
    <category field="chemistry"/>
    <issn>0006-2979</issn>
    <eissn>1608-3040</eissn>
    <summary>Custom numeric style for Biochemistry Moscow.</summary>
    <updated>2026-08-04T19:06:00+00:00</updated>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=", "
            initialize-with=". "
            and="text"
            delimiter=", "
            delimiter-precedes-last="always"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued" prefix=" (" suffix=") ">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="doi-or-url">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="https://doi.org/"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>

  <macro name="journal-article">
    <group>
      <text variable="title"/>
      <text variable="container-title" form="short" font-style="italic" prefix=", "/>
      <text variable="volume" font-weight="bold" prefix=", "/>
      <text variable="page" prefix=", "/>
      <text macro="doi-or-url" prefix=", "/>
    </group>
  </macro>

  <macro name="book">
    <group>
      <text variable="title" font-style="italic"/>
      <group prefix=", " delimiter=" ">
        <number variable="edition" form="ordinal"/>
        <text term="edition" form="short"/>
      </group>
      <text variable="publisher" prefix=", "/>
      <text variable="publisher-place" prefix=", "/>
      <text macro="doi-or-url" prefix=", "/>
    </group>
  </macro>

  <macro name="chapter">
    <group>
      <text variable="title"/>
      <text term="in" text-case="lowercase" prefix=", " suffix=" "/>
      <text variable="container-title" font-style="italic"/>
      <names variable="editor" prefix=" (" suffix=")">
        <name name-as-sort-order="all"
              sort-separator=", "
              initialize-with=". "
              and="text"
              delimiter=", "
              delimiter-precedes-last="always"/>
        <label form="short" prefix=", "/>
      </names>
      <text variable="publisher" prefix=", "/>
      <text variable="publisher-place" prefix=", "/>
      <group prefix=", ">
        <label variable="page" form="short" suffix=" " strip-periods="true"/>
        <text variable="page"/>
      </group>
      <text macro="doi-or-url" prefix=", "/>
    </group>
  </macro>

  <macro name="report-thesis">
    <group>
      <text variable="title" font-style="italic"/>
      <text variable="genre" prefix=", "/>
      <text variable="publisher" prefix=", "/>
      <text variable="publisher-place" prefix=", "/>
      <text macro="doi-or-url" prefix=", "/>
    </group>
  </macro>

  <macro name="web">
    <group>
      <text variable="title"/>
      <text variable="container-title" font-style="italic" prefix=", "/>
      <text variable="publisher" prefix=", "/>
      <text macro="doi-or-url" prefix=", "/>
      <date variable="accessed" prefix=" (accessed " suffix=")">
        <date-part name="day" suffix=" "/>
        <date-part name="month" form="short" suffix=" "/>
        <date-part name="year"/>
      </date>
    </group>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush"
                entry-spacing="0"
                line-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <text macro="author"/>
      <text macro="year"/>
      <choose>
        <if type="article-journal article-magazine article-newspaper" match="any">
          <text macro="journal-article"/>
        </if>
        <else-if type="chapter paper-conference entry-encyclopedia entry-dictionary" match="any">
          <text macro="chapter"/>
        </else-if>
        <else-if type="book" match="any">
          <text macro="book"/>
        </else-if>
        <else-if type="report thesis" match="any">
          <text macro="report-thesis"/>
        </else-if>
        <else-if type="webpage post post-weblog" match="any">
          <text macro="web"/>
        </else-if>
        <else>
          <text variable="title"/>
          <text variable="container-title" font-style="italic" prefix=", "/>
          <text variable="volume" font-weight="bold" prefix=", "/>
          <text variable="page" prefix=", "/>
          <text macro="doi-or-url" prefix=", "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
